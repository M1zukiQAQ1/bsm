# Open the viewer.
/vis/open OGLSQt

# Display your target.
/vis/drawVolume Target
/vis/viewer/set/style wireframe
/vis/viewer/set/viewpointThetaPhi 70 30
/vis/scene/add/axes 0 0 0 10 mm

# Display particle tracks and overlay events.
/vis/scene/add/trajectories rich
/vis/scene/endOfEventAction accumulate 20
/vis/viewer/set/autoRefresh true


# White cross at the gun position
/vis/set/colour white
/vis/scene/add/line -0.5 0 -5 0.5 0 -5 mm
/vis/scene/add/line 0 -0.5 -5 0 0.5 -5 mm

# Arrow from the source toward the target
/vis/scene/add/arrow 0 0 -5 0 0 -3 mm

# Label anchored at the source
/vis/set/textColour white
/vis/scene/add/text 0 0 -5 mm 16 8 8 Muon gun

# Color trajectories by particle name
/vis/modeling/trajectories/create/drawByParticleID
/vis/modeling/trajectories/drawByParticleID-0/set mu- cyan
/vis/modeling/trajectories/drawByParticleID-0/set e- red
/vis/modeling/trajectories/drawByParticleID-0/set e+ blue
/vis/modeling/trajectories/drawByParticleID-0/set gamma yellow
/vis/modeling/trajectories/drawByParticleID-0/set neutron green
/vis/modeling/trajectories/drawByParticleID-0/set proton magenta
/vis/modeling/trajectories/drawByParticleID-0/set nu_mu grey
/vis/modeling/trajectories/drawByParticleID-0/set anti_nu_e grey
/vis/modeling/trajectories/select drawByParticleID-0

# Run five events.
/tracking/verbose 0
/run/beamOn 10
/vis/viewer/flush 


